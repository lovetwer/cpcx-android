<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Lottery" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- 文本样式：对齐 styles.css -->
    <style name="TextAppearance.Lottery.H2" parent="">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight" tools:targetApi="28">700</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Lottery.Title" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>

    <style name="TextAppearance.Lottery.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Lottery.Body.Strong" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>

    <style name="TextAppearance.Lottery.Muted" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="TextAppearance.Lottery.Muted.Strong" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>

    <style name="TextAppearance.Lottery.Eyebrow" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- 卡片：细边框 + 轻投影 -->
    <style name="Widget.Lottery.Card">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- 按钮 -->
    <style name="Widget.Lottery.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">9dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Lottery.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">9dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Lottery.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="backgroundTint">@color/danger</item>
        <item name="cornerRadius">9dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Lottery.Button.Large" parent="">
        <item name="android:minHeight">46dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Lottery.EditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>
</resources>
